{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agrowthwebsite",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "agrowth.adm@gmail.com"
    }
  ]
}